// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [uuid_ossp(map: "uuid-ossp"), pg_trgm, pgcrypto]
}

// ============================================
// Enums
// ============================================

enum UserRole {
  SUPER_ADMIN
  ORG_ADMIN
  GRC_MANAGER
  CONTROL_OWNER
  AUDITOR
  VIEWER
}

enum ControlStatus {
  NOT_IMPLEMENTED
  PARTIALLY_IMPLEMENTED
  IMPLEMENTED
  INEFFECTIVE
  DEPRECATED
}

enum TestingStatus {
  NOT_TESTED
  TESTED
  FAILED
  PARTIALLY_TESTED
}

enum RiskLevel {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  UNKNOWN
}

enum RiskStatus {
  IDENTIFIED
  ANALYZING
  EVALUATED
  TREATING
  MONITORING
  CLOSED
  ARCHIVED
}

enum TreatmentStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
}

enum TreatmentType {
  MITIGATE
  ACCEPT
  TRANSFER
  AVOID
}

enum AssessmentStatus {
  DRAFT
  PLANNED
  IN_PROGRESS
  COMPLETED
  PUBLISHED
  ARCHIVED
}

enum ComplianceStatus {
  COMPLIANT
  NON_COMPLIANT
  PARTIALLY_COMPLIANT
  NOT_APPLICABLE
  NOT_ASSESSED
}

enum DocumentType {
  POLICY
  PROCEDURE
  TEMPLATE
  GUIDELINE
  STANDARD
  EVIDENCE
  REPORT
  CONTRACT
  OTHER
}

enum DocumentStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  ARCHIVED
  OBSOLETE
}

enum EvidenceType {
  DOCUMENT
  SCREENSHOT
  CONFIGURATION
  LOG
  INTERVIEW
  SYSTEM_REPORT
  THIRD_PARTY
  OTHER
}

enum FrameworkCategory {
  COMPLIANCE
  SECURITY
  PRIVACY
  INDUSTRY
  CUSTOM
}

enum AuditStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  FOLLOW_UP
}

enum AuditFindingStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  ACCEPTED
  REJECTED
}

// ============================================
// Models
// ============================================

model Account {
  id                 String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)


  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id            String   @id @default(cuid())
  sessionToken  String   @unique
  userId        String
  expires       DateTime
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent     String?
  ipAddress     String?
  lastActivity  DateTime @default(now())
  
  @@index([userId])
}

model User {
  id                  String                @id @default(uuid())
  email               String                @unique
  name                String?
  role                UserRole              @default(VIEWER)
  password            String?
  emailVerified       DateTime?
  image               String?
  title               String?
  department          String?
  phone               String?
  isActive            Boolean               @default(true)
  lastLogin           DateTime?
  timezone            String?               @default("UTC")
  locale             String?               @default("en-US")
  mfaEnabled         Boolean               @default(false)
  mfaSecret          String?
  
  // Relations
  organization        Organization?         @relation(fields: [organizationId], references: [id])
  organizationId      String?
  sessions            Session[]
  accounts            Account[]
  
  // Framework Relations
  createdFrameworks   Framework[]           @relation("FrameworkCreatedBy")
  updatedFrameworks   Framework[]           @relation("FrameworkUpdatedBy")
  
  // Control Relations
  createdControls     Control[]             @relation("ControlCreatedBy")
  updatedControls     Control[]             @relation("ControlUpdatedBy")
  ownedControls       Control[]             @relation("ControlOwner")
  
  // Risk Relations
  createdRisks        Risk[]                @relation("RiskCreatedBy")
  updatedRisks        Risk[]                @relation("RiskUpdatedBy")
  ownedRisks          Risk[]                @relation("RiskOwner")
  riskAssessments     RiskAssessment[]      @relation("RiskAssessmentAssessor")
  
  // Treatment Relations
  assignedTreatments   RiskTreatment[]       @relation("TreatmentAssignedTo")
  createdTreatments   RiskTreatment[]       @relation("TreatmentCreatedBy")
  updatedTreatments   RiskTreatment[]       @relation("TreatmentUpdatedBy")
  
  // Risk Scenario Relations
  createdRiskScenarios RiskScenario[]  @relation("ScenarioCreatedBy")
  updatedRiskScenarios RiskScenario[]  @relation("ScenarioUpdatedBy")
  
  // Assessment Relations
  createdAssessments  Assessment[]          @relation("AssessmentCreatedBy")
  updatedAssessments  Assessment[]          @relation("AssessmentUpdatedBy")
  
  // Document Relations
  createdDocuments    Document[]            @relation("DocumentCreatedBy")
  updatedDocuments    Document[]            @relation("DocumentUpdatedBy")
  
  // Evidence Relations
  uploadedEvidences   Evidence[]            @relation("EvidenceUploadedBy")
  
  // Audit Relations
  createdAudits       Audit[]               @relation("AuditCreatedBy")
  updatedAudits       Audit[]               @relation("AuditUpdatedBy")
  auditFindings       AuditFinding[]        @relation("AuditFindingAssignedTo")
  
  // Incident Relations
  createdIncidents    Incident[]            @relation("IncidentCreatedBy")
  updatedIncidents    Incident[]            @relation("IncidentUpdatedBy")
  
  // Vendor Relations
  createdVendors      Vendor[]              @relation("VendorCreatedBy")
  updatedVendors      Vendor[]              @relation("VendorUpdatedBy")
  vendorAssessments   VendorAssessment[]    @relation("VendorAssessmentAssessor")
  
  // Contract Relations
  createdContracts    Contract[]            @relation("ContractCreatedBy")
  updatedContracts    Contract[]            @relation("ContractUpdatedBy")
  
  // Other Relations
  notifications       Notification[]        @relation("NotificationRecipient")
  comments            Comment[]             @relation("CommentAuthor")
  
  // Timestamps
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  
  @@index([email])
  @@index([organizationId])
}

model Organization {
  id           String     @id @default(uuid())
  name         String
  description  String?    @db.Text
  domain       String?    @unique
  logo         String?
  settings     Json       @default("{}")
  industry     String?
  size         String?    // small, medium, large, enterprise
  country      String?
  timezone     String?    @default("UTC")
  isActive     Boolean    @default(true)
  
  // Relations
  users        User[]
  frameworks   Framework[]
  controls     Control[]
  risks        Risk[]
  assessments  Assessment[]
  audits       Audit[]
  documents    Document[]
  evidences    Evidence[]
  incidents    Incident[]
  vendors      Vendor[]
  contracts    Contract[]
  vendorAssessments VendorAssessment[]
  
  // Timestamps
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  
  @@index([name])
  @@index([domain])
}

model Framework {
  id           String       @id @default(uuid())
  name         String
  version      String?
  description  String?     @db.Text
  category     FrameworkCategory
  isCustom     Boolean      @default(false)
  isActive     Boolean      @default(true)
  metadata     Json?        @default("{}")
  
  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  requirements   Requirement[]
  assessments    Assessment[]
  createdBy      User?        @relation("FrameworkCreatedBy", fields: [createdById], references: [id])
  createdById    String?
  updatedBy      User?        @relation("FrameworkUpdatedBy", fields: [updatedById], references: [id])
  updatedById    String?
  
  // Timestamps
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  
  @@unique([organizationId, name, version])
  @@index([organizationId])
  @@index([category])
}

model Requirement {
  id           String   @id @default(uuid())
  referenceId  String
  title        String
  description  String?  @db.Text
  category     String?
  level        String?  // mandatory, recommended, optional
  metadata     Json?    @default("{}")
  
  // Relations
  framework    Framework @relation(fields: [frameworkId], references: [id])
  frameworkId  String
  controls     ControlRequirement[]
  findings     Finding[]
  auditFindings AuditFinding[]
  
  // Timestamps
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@index([frameworkId])
  @@index([referenceId])
}

model Control {
  id                  String       @id @default(uuid())
  name                String
  description        String?      @db.Text
  category           String?
  family             String?
  implementationStatus ControlStatus @default(NOT_IMPLEMENTED)
  testingStatus      TestingStatus  @default(NOT_TESTED)
  notes              String?      @db.Text
  referenceUrl       String?
  isAutomated        Boolean      @default(false)
  isActive           Boolean      @default(true)
  metadata           Json?        @default("{}")
  
  // Relations
  organization       Organization @relation(fields: [organizationId], references: [id])
  organizationId     String
  requirements       ControlRequirement[]
  evidences          Evidence[]
  risksMitigated     RiskControl[]
  auditFindings      AuditFinding[]
  owner              User?        @relation("ControlOwner", fields: [ownerId], references: [id])
  ownerId            String?
  createdBy          User?        @relation("ControlCreatedBy", fields: [createdById], references: [id])
  createdById        String?
  updatedBy          User?        @relation("ControlUpdatedBy", fields: [updatedById], references: [id])
  updatedById        String?
  
  // Timestamps
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  
  @@index([organizationId])
  @@index([family])
  @@index([ownerId])
}

model ControlRequirement {
  id            String      @id @default(uuid())
  control       Control     @relation(fields: [controlId], references: [id])
  controlId     String
  requirement   Requirement @relation(fields: [requirementId], references: [id])
  requirementId String
  mappingType   String?     // implements, supports, related
  notes         String?     @db.Text
  
  @@unique([controlId, requirementId])
}

model Risk {
  id                   String          @id @default(uuid())
  title                String
  description          String?         @db.Text
  category             String?
  threatSource         String?         @db.Text
  vulnerability        String?         @db.Text
  impactDescription    String?         @db.Text
  likelihood           Int             @default(1)
  impact               Int             @default(1)
  inherentRiskScore    Float
  currentRiskScore     Float
  targetRiskScore      Float?
  treatment            TreatmentType   @default(MITIGATE)
  status               RiskStatus      @default(IDENTIFIED)
  reviewDate           DateTime?
  mitigationStrategy   String?         @db.Text
  residualRiskNotes    String?         @db.Text
  metadata             Json?           @default("{}")
  
  // Relations
  organization         Organization    @relation(fields: [organizationId], references: [id])
  organizationId       String
  owner                User?           @relation("RiskOwner", fields: [ownerId], references: [id])
  ownerId              String?
  createdBy            User?           @relation("RiskCreatedBy", fields: [createdById], references: [id])
  createdById          String?
  updatedBy            User?           @relation("RiskUpdatedBy", fields: [updatedById], references: [id])
  updatedById          String?
  mitigationControls   RiskControl[]
  treatments           RiskTreatment[]
  assessments          RiskAssessment[]
  incidents            Incident[]
  
  // Timestamps
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  
  @@index([organizationId])
  @@index([ownerId])
  @@index([status])
  @@index([inherentRiskScore])
  @@index([currentRiskScore])
}

model RiskControl {
  id        String  @id @default(uuid())
  risk      Risk    @relation(fields: [riskId], references: [id])
  riskId    String
  control   Control @relation(fields: [controlId], references: [id])
  controlId String
  notes     String? @db.Text
  
  @@unique([riskId, controlId])
}

model RiskTreatment {
  id            String         @id @default(uuid())
  risk          Risk           @relation(fields: [riskId], references: [id])
  riskId        String
  type          TreatmentType
  status        TreatmentStatus @default(PLANNED)
  title         String
  description   String?         @db.Text
  dueDate       DateTime?
  completionDate DateTime?
  costEstimate  Float?
  budgetAllocated Float?
  actualCost    Float?
  notes         String?        @db.Text
  metadata      Json?          @default("{}")
  
  // Relations
  assignedTo    User?          @relation("TreatmentAssignedTo", fields: [assignedToId], references: [id])
  assignedToId  String?
  createdBy     User?          @relation("TreatmentCreatedBy", fields: [createdById], references: [id])
  createdById   String?
  updatedBy     User?          @relation("TreatmentUpdatedBy", fields: [updatedById], references: [id])
  updatedById   String?
  
  // Timestamps
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
  @@index([riskId])
  @@index([assignedToId])
  @@index([status])
  @@index([dueDate])
}

model RiskAssessment {
  id              String        @id @default(uuid())
  risk            Risk          @relation(fields: [riskId], references: [id])
  riskId          String
  assessmentDate  DateTime      @default(now())
  assessedBy      User          @relation("RiskAssessmentAssessor", fields: [assessedById], references: [id])
  assessedById    String
  likelihood      Int
  impact          Int
  riskScore       Float
  notes           String?       @db.Text
  metadata        Json?         @default("{}")
  scenarios       RiskScenario[]
  
  // Timestamps
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  @@index([riskId])
  @@index([assessedById])
  @@index([assessmentDate])
}

model RiskScenario {
  id                String         @id @default(uuid())
  name              String
  description       String?        @db.Text
  likelihoodScore   Int
  impactScore       Int
  riskScore         Float
  riskLevel         RiskLevel
  threatSource      String?        @db.Text
  threatEvent       String?        @db.Text
  vulnerability     String?        @db.Text
  riskCatalogId     String?
  
  // Relations
  riskAssessment    RiskAssessment @relation(fields: [riskAssessmentId], references: [id])
  riskAssessmentId  String
  createdBy         User           @relation("ScenarioCreatedBy", fields: [createdById], references: [id])
  createdById       String
  updatedBy         User?          @relation("ScenarioUpdatedBy", fields: [updatedById], references: [id])
  updatedById       String?
  
  // Timestamps
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  
  @@index([riskAssessmentId])
  @@index([riskLevel])
}

model Assessment {
  id              String       @id @default(uuid())
  name            String
  description     String?      @db.Text
  framework       Framework    @relation(fields: [frameworkId], references: [id])
  frameworkId     String
  status          AssessmentStatus @default(DRAFT)
  startDate       DateTime?
  endDate         DateTime?
  scope           String?      @db.Text
  methodology     String?
  overallScore    Float?
  maturityLevel   Int?
  notes           String?      @db.Text
  metadata        Json?        @default("{}")
  
  // Relations
  organization    Organization @relation(fields: [organizationId], references: [id])
  organizationId  String
  findings        Finding[]
  createdBy       User?        @relation("AssessmentCreatedBy", fields: [createdById], references: [id])
  createdById     String?
  updatedBy       User?        @relation("AssessmentUpdatedBy", fields: [updatedById], references: [id])
  updatedById     String?
  
  // Timestamps
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  
  @@index([organizationId])
  @@index([frameworkId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
}

model Finding {
  id              String   @id @default(uuid())
  assessment      Assessment @relation(fields: [assessmentId], references: [id])
  assessmentId    String
  requirement     Requirement @relation(fields: [requirementId], references: [id])
  requirementId   String
  status          ComplianceStatus @default(NOT_ASSESSED)
  evidence        Evidence[]
  gaps            String?   @db.Text
  recommendations String?   @db.Text
  riskRating      String?   // critical, high, medium, low
  dueDate         DateTime?
  
  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([assessmentId])
  @@index([requirementId])
  @@index([status])
}

model Audit {
  id              String       @id @default(uuid())
  name            String
  description     String?      @db.Text
  type            String?      // internal, external, certification
  status          AuditStatus  @default(PLANNED)
  startDate       DateTime?
  endDate         DateTime?
  scope           String?      @db.Text
  objectives      String?      @db.Text
  criteria        String?      @db.Text
  methodology     String?
  notes           String?      @db.Text
  metadata        Json?        @default("{}")
  
  // Relations
  organization    Organization @relation(fields: [organizationId], references: [id])
  organizationId  String
  findings        AuditFinding[]
  createdBy       User?        @relation("AuditCreatedBy", fields: [createdById], references: [id])
  createdById     String?
  updatedBy       User?        @relation("AuditUpdatedBy", fields: [updatedById], references: [id])
  updatedById     String?
  
  // Timestamps
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  
  @@index([organizationId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
}

model AuditFinding {
  id              String       @id @default(uuid())
  audit           Audit        @relation(fields: [auditId], references: [id])
  auditId         String
  title           String
  description     String?      @db.Text
  requirementId   String?
  requirement     Requirement? @relation(fields: [requirementId], references: [id])
  controlId       String?
  control         Control?     @relation(fields: [controlId], references: [id])
  severity        String?      // critical, high, medium, low
  status          AuditFindingStatus @default(OPEN)
  evidence        Evidence[]
  rootCause       String?      @db.Text
  recommendation  String?      @db.Text
  managementResponse String?    @db.Text
  correctiveAction String?     @db.Text
  dueDate         DateTime?
  completedDate   DateTime?
  
  // Relations
  assignedTo      User?        @relation("AuditFindingAssignedTo", fields: [assignedToId], references: [id])
  assignedToId    String?
  
  // Timestamps
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  
  @@index([auditId])
  @@index([requirementId])
  @@index([controlId])
  @@index([severity])
  @@index([status])
  @@index([assignedToId])
  @@index([dueDate])
}

model Document {
  id              String       @id @default(uuid())
  name            String
  description     String?      @db.Text
  type            DocumentType
  status          DocumentStatus @default(DRAFT)
  version         String?      @default("1.0")
  effectiveDate   DateTime?
  reviewDate      DateTime?
  fileUrl         String?
  fileSize        Int?
  fileType        String?
  content         String?      @db.Text
  metadata        Json?        @default("{}")
  
  // Relations
  organization    Organization @relation(fields: [organizationId], references: [id])
  organizationId  String
  createdBy       User?        @relation("DocumentCreatedBy", fields: [createdById], references: [id])
  createdById     String?
  updatedBy       User?        @relation("DocumentUpdatedBy", fields: [updatedById], references: [id])
  updatedById     String?
  
  // Timestamps
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  
  @@index([organizationId])
  @@index([type])
  @@index([status])
  @@index([effectiveDate])
  @@index([reviewDate])
}

model Evidence {
  id              String       @id @default(uuid())
  name            String
  description     String?      @db.Text
  type            EvidenceType
  collectionDate  DateTime     @default(now())
  validityPeriod  Int?         // in days
  fileUrl         String?
  fileSize        Int?
  fileType        String?
  content         String?      @db.Text
  metadata        Json?        @default("{}")
  
  // Relations
  organization    Organization @relation(fields: [organizationId], references: [id])
  organizationId  String
  uploadedBy      User?        @relation("EvidenceUploadedBy", fields: [uploadedById], references: [id])
  uploadedById    String?
  control         Control?     @relation(fields: [controlId], references: [id])
  controlId       String?
  finding         Finding?     @relation(fields: [findingId], references: [id])
  findingId       String?
  auditFinding    AuditFinding? @relation(fields: [auditFindingId], references: [id])
  auditFindingId  String?
  
  // Timestamps
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  
  @@index([organizationId])
  @@index([type])
  @@index([controlId])
  @@index([findingId])
  @@index([auditFindingId])
  @@index([uploadedById])
}

model Notification {
  id              String       @id @default(uuid())
  title           String
  message         String      @db.Text
  type            String?     // info, success, warning, error
  isRead          Boolean     @default(false)
  actionUrl       String?
  
  // Relations
  recipient       User        @relation("NotificationRecipient", fields: [recipientId], references: [id])
  recipientId     String
  
  // Timestamps
  createdAt       DateTime    @default(now())
  readAt          DateTime?
  
  @@index([recipientId])
  @@index([isRead])
  @@index([createdAt])
}

model Comment {
  id              String       @id @default(uuid())
  content         String      @db.Text
  
  // Relations
  author          User        @relation("CommentAuthor", fields: [authorId], references: [id])
  authorId        String
  parentId        String?     // For nested comments
  parentType      String?     // e.g., 'Risk', 'Control', 'Finding', etc.
  
  // Timestamps
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  @@index([authorId])
  @@index([parentId, parentType])
}

model Incident {
  id              String       @id @default(uuid())
  title           String
  description     String?      @db.Text
  status          String       @default("reported") // reported, investigating, contained, resolved, closed
  severity        String?      // critical, high, medium, low
  impact          String?      // high, medium, low
  detectionDate   DateTime?    @default(now())
  resolutionDate  DateTime?
  rootCause       String?      @db.Text
  remediation     String?      @db.Text
  lessonsLearned  String?      @db.Text
  metadata        Json?        @default("{}")
  
  // Relations
  organization    Organization @relation(fields: [organizationId], references: [id])
  organizationId  String
  relatedRisks    Risk[]
  createdBy       User?        @relation("IncidentCreatedBy", fields: [createdById], references: [id])
  createdById     String?
  updatedBy       User?        @relation("IncidentUpdatedBy", fields: [updatedById], references: [id])
  updatedById     String?
  
  // Timestamps
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  
  @@index([organizationId])
  @@index([status])
  @@index([severity])
  @@index([detectionDate])
}

model Vendor {
  id              String       @id @default(uuid())
  name            String
  description     String?      @db.Text
  website         String?
  contactName     String?
  contactEmail    String?
  contactPhone    String?
  address         String?     @db.Text
  country         String?
  isActive        Boolean      @default(true)
  riskRating      String?     // high, medium, low
  lastAssessmentDate DateTime?
  nextAssessmentDate DateTime?
  notes           String?     @db.Text
  metadata        Json?       @default("{}")
  
  // Relations
  organization    Organization @relation(fields: [organizationId], references: [id])
  organizationId  String
  contracts       Contract[]
  assessments     VendorAssessment[]
  createdBy       User?        @relation("VendorCreatedBy", fields: [createdById], references: [id])
  createdById     String?
  updatedBy       User?        @relation("VendorUpdatedBy", fields: [updatedById], references: [id])
  updatedById     String?
  
  // Timestamps
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  
  @@index([organizationId])
  @@index([name])
  @@index([isActive])
  @@index([riskRating])
}

model Contract {
  id              String       @id @default(uuid())
  name            String
  description     String?      @db.Text
  referenceNumber String?
  startDate       DateTime?
  endDate         DateTime?
  renewalDate     DateTime?
  status          String?      // active, expired, terminated, under_review
  value           Float?
  currency        String?      @default("USD")
  notes           String?      @db.Text
  fileUrl         String?
  metadata        Json?        @default("{}")
  
  // Relations
  vendor          Vendor       @relation(fields: [vendorId], references: [id])
  vendorId        String
  organization    Organization @relation(fields: [organizationId], references: [id])
  organizationId  String
  createdBy       User?        @relation("ContractCreatedBy", fields: [createdById], references: [id])
  createdById     String?
  updatedBy       User?        @relation("ContractUpdatedBy", fields: [updatedById], references: [id])
  updatedById     String?
  
  // Timestamps
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  
  @@index([organizationId])
  @@index([vendorId])
  @@index([status])
  @@index([endDate])
  @@index([renewalDate])
}

model VendorAssessment {
  id              String       @id @default(uuid())
  title           String
  description     String?      @db.Text
  assessmentDate  DateTime     @default(now())
  dueDate         DateTime?
  status          String?      // planned, in_progress, completed, overdue
  score           Float?
  riskRating      String?      // high, medium, low
  notes           String?      @db.Text
  fileUrl         String?
  metadata        Json?        @default("{}")
  
  // Relations
  vendor          Vendor       @relation(fields: [vendorId], references: [id])
  vendorId        String
  organization    Organization @relation(fields: [organizationId], references: [id])
  organizationId  String
  assessedBy      User?        @relation("VendorAssessmentAssessor", fields: [assessedById], references: [id])
  assessedById    String?
  
  // Timestamps
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  
  @@index([organizationId])
  @@index([vendorId])
  @@index([status])
  @@index([assessmentDate])
  @@index([dueDate])
  @@index([assessedById])
}

